# --- Database ---
DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/deepfake_kyc

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
UPLOAD_DIR=./storage/uploads
TEMP_VIDEO_DIR=./storage/temp_video
MODEL_DIR=./storage/models
MAX_UPLOAD_MB=10

# --- Risk thresholds (configurable, not hard-coded in pipeline logic) ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70
FACE_MATCH_THRESHOLD=0.55

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
